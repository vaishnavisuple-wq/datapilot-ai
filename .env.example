# ==============================================================================
# DataPilot AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your values as needed:
# cp .env.example .env

# Server Configuration
HOST=0.0.0.0
PORT=8000
MAX_FILE_SIZE_MB=50

# Intelligence Engine Provider Options:
# "local_engine" (Default - 100% offline, zero keys needed, deterministic Pandas math)
# "gemini"       (Google Generative AI)
# "openai"       (OpenAI / Compatible endpoints)
DEFAULT_LLM_PROVIDER=local_engine
DEFAULT_MODEL=gemini-1.5-flash

# Google Gemini API Key (Optional: only needed if using Gemini provider)
# Get yours at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Optional: only needed if using OpenAI provider)
# Get yours at: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_BASE_URL=
